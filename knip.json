{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/main.ts!"],
  "project": ["src/app/**/*.ts!"],
  "rules": {
    "cycles": "error"
  },
  "ignoreBinaries": ["ng"],
  "ignoreDependencies": ["@angular/forms", "@firebase/ai"],
  "ignore": [
    "src/app/features/culinary-guide/**",
    "src/app/core/culinary-guide/**",
    "src/app/shared/ui/components/accordion/**",
    "src/app/shared/ui/icons/expand-more-icon/**"
  ]
}
