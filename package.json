{
  "name": "ng-firebase-image-analyzer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node firebase/scripts/prebuild.mjs",
    "build": "ng build",
    "build:stats": "ng build --configuration=production --stats-json",
    "preview": "npm run build && npx serve dist/ng-firebase-image-analyzer/browser --listen 5005 -s",
    "preview:emulator": "npm run build && npx serve dist/ng-firebase-image-analyzer/browser --listen $PORT",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:once": "ng test --watch=false",
    "test:spec": "ng test --watch=false --include",
    "check:cycles": "knip --cycles --reporter cycles",
    "lint": "ng lint && npm run check:cycles && knip --production && npm run cspell",
    "lint:fix": "eslint \"src/**/*.{ts,js,mjs}\" --fix",
    "format": "prettier --write \"{src,firebase}/**/*.{ts,js,mjs,html}\" \"*.{mjs,json,md}\"",
    "cspell": "cspell --no-must-find-files --config cspell.config.mjs .",
    "cspell:collect": "cspell --words-only --unique --no-must-find-files --config cspell.config.mjs . .scratch | sort -u -o .cspell/project-words.txt .cspell/project-words.txt -",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "prepare": "husky",
    "firebase:emulate": "firebase emulators:start --project default",
    "config:fetch": "node firebase/scripts/get-firebase-remote-config.mjs",
    "config:generate": "node firebase/scripts/generate-firebase-config.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "dompurify": "3.4.17",
    "firebase": "13.2.0",
    "jsonrepair": "3.15.0",
    "rxjs": "~7.8.2",
    "snarkdown": "2.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.5",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "22.6.0",
    "cspell": "10.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-unicorn": "79.0.0",
    "firebase-tools": "15.35.0",
    "husky": "9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^27.1.0",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "serve": "14.2.7",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.0.8"
  }
}
